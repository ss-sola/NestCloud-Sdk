{
  "name": "@nest-cloud/sdk",
  "version": "1.0.0",
  "private": true,
  "description": "NestCloud SDK for NestJS configuration, service discovery and shared infrastructure",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".husky/install.mjs"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "format": "oxfmt --write src vitest.config.mts",
    "lint": "oxlint src vitest.config.mts",
    "test": "vitest run",
    "tsgo": "tsc --noEmit -p tsconfig.json",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/typeorm": "^12.0.3",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "axios": "^1.21.1",
    "chalk": "^6.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "express-session": "^1.19.0",
    "fast-glob": "^3.3.3",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.5.0",
    "opossum": "^10.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsc-alias": "^1.9.10",
    "typescript": "^7.0.2",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxfmt --write",
      "oxlint"
    ],
    "*.{json,md,yml,yaml}": "oxfmt --write"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
